# ---- M-Pesa (https://lipana.dev) ----
LIPANA_SECRET_KEY=
LIPANA_WEBHOOK_SECRET=
LIPANA_ENVIRONMENT=sandbox            # 'sandbox' for testing, 'production' to go live

# ---- Supabase (https://supabase.com) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---- WhatsApp ----
# 'baileys' = FREE (scan QR, no Meta verification needed) - great for trials
# 'meta'    = Meta WhatsApp Cloud API (requires business verification + template approval)
WHATSAPP_MODE=baileys
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Template names you create in Meta business platform.
# If left blank the app falls back to plain text messages (may not reach new users).
WHATSAPP_TEMPLATE_FIXTURE=
WHATSAPP_TEMPLATE_WIN=
WHATSAPP_TEMPLATE_LOST=
WHATSAPP_TEMPLATE_DISPUTE=

# ---- Admin ----
ADMIN_PASSWORD=

# ---- Site ----
# Public URL of the deployed app, used to build WhatsApp upload links.
# Local: http://localhost:3000   Live: https://your-app.vercel.app
# NEXT_PUBLIC_* vars are also visible in the browser - keep BASE_URL server-only too.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BASE_URL=http://localhost:3000

# ---- Tournament schedule (EAT) ----
TOURNAMENT_DAYS=1,3,5                 # 1=Mon 3=Wed 5=Fri
TOURNAMENT_HOUR=20                    # 20 = 8PM East Africa Time
ENTRY_FEE_KES=100
MAX_PLAYERS=32